{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/coverage",
      "!**/bun.lock",
      "!**/*.tsbuildinfo",
      "!**/next-env.d.ts",
      "!**/*.md",
      "!pr-12-work",
      "!record-demo.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": { "allow": ["info", "warn", "error"] }
        }
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error",
        "noDescendingSpecificity": "off"
      },
      "performance": {
        "noImgElement": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
