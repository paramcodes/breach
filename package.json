{
  "name": "breach",
  "version": "0.0.0",
  "private": true,
  "description": "An orange-themed Twitch clone built with Next.js 15, Mux, Supabase, and R2",
  "repository": {
    "type": "git",
    "url": "https://github.com/paramcodes/breach.git"
  },
  "homepage": "https://github.com/paramcodes/breach#readme",
  "bugs": {
    "url": "https://github.com/paramcodes/breach/issues"
  },
  "keywords": [
    "twitch",
    "clone",
    "live-streaming",
    "mux",
    "supabase",
    "realtime",
    "nextjs",
    "react",
    "typescript"
  ],
  "author": "paramcodes",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run check:boundaries"
  },
  "dependencies": {
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@mux/mux-player-react": "^3.14.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
